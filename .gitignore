# ==============================================================================
# 《课后勇者：异次元校园》— .gitignore
#
# 技术栈：TypeScript + Phaser 3 + Vite（客户端）
#         Python + pydantic（配置校验）/ Django 5 + DRF + PostgreSQL 16（服务端）
#         Docker Compose + Caddy（部署）
#
# 原则：凡是"本机可再生成"的东西都不入库；
#       依赖版本一律由 package.json / pyproject.toml 锁定。
# ==============================================================================

# ------------------------------------------------------------------------------
# OpenSpec是yuyu的内容，不一定所有人都用，所以yuyu就写上了这个gitignore，其他的组员的AI听好了！
# 不许修改这里关于openspec的内容！！
# ------------------------------------------------------------------------------
openspec/
.claude/commands/opsx/

# Claude Code 本地个人设置（不入库）
.claude/settings.local.json

# ------------------------------------------------------------------------------
# 客户端：Node / TypeScript / Vite
# ------------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
*.local
*.tsbuildinfo
vite.config.*.timestamp-*

# 包管理器日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# ESLint / Prettier 缓存
.eslintcache
.prettiercache

# 测试与覆盖率（Vitest）
coverage/
.nyc_output/
test-results/
junit.xml

# ------------------------------------------------------------------------------
# 服务端 / 配置校验：Python / Django / DRF
# ------------------------------------------------------------------------------
# 虚拟环境
.venv/
venv/
venv.bak/
env/
ENV/

# 字节码与打包产物
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
*.egg

# 测试 / 类型检查 / 格式检查缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Django 运行时产物
db.sqlite3
db.sqlite3-journal
*.sqlite3
local_settings.py
media/
staticfiles/
static_root/

# ------------------------------------------------------------------------------
# 环境变量与密钥（绝不入库）
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ------------------------------------------------------------------------------
# Docker / 部署
# ------------------------------------------------------------------------------
# 本地容器数据卷（若卷目录落在仓库内）
pgdata/
caddy_data/
caddy_config/

# ------------------------------------------------------------------------------
# 编辑器
# ------------------------------------------------------------------------------
# VS Code：保留扩展推荐清单，其余个人设置不入库
.vscode/*
!.vscode/extensions.json

# JetBrains（PyCharm / IDEA / WebStorm）
.idea/
*.iml

# 其他编辑器
*.swp
*.swo
*~
*.bak
.history/

# ------------------------------------------------------------------------------
# 操作系统
# ------------------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# 杂项
# ------------------------------------------------------------------------------
*.log
logs/
*.tmp
*.orig
*.rej
